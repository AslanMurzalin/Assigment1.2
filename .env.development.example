# Link Saver — Development Environment Configuration
ENV=development
DEBUG=true

# Database Configuration (Development)
POSTGRES_DB=linksaver_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Application Port
BACKEND_PORT=8000

# Security (Development Key)
SECRET_KEY=dev-insecure-secret-key-change-me-12345

# Marketplace BHAPI Integration (Optional)
BHAPI_TOKEN=
BHAPI_BASE_URL=https://bhapi.ru

# OpenTelemetry (Local Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=linksaver-backend-dev

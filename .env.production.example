# Link Saver — Production Environment Configuration
ENV=production
DEBUG=false

# Database Configuration (Production — USE STRONG PASSWORDS!)
POSTGRES_DB=linksaver_prod
POSTGRES_USER=linksaver_admin
POSTGRES_PASSWORD=replace_with_strong_production_password_min_32_chars
POSTGRES_PORT=5432

# Application Port
APP_PORT=8000
PROD_IMAGE=linksaver:prod

# Security (Production Secret Key — MUST be a 64+ char random token)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_cryptographically_secure_random_key_in_production

# Marketplace BHAPI Integration
BHAPI_TOKEN=your_bhapi_production_token
BHAPI_BASE_URL=https://bhapi.ru

# OpenTelemetry Collector (Production APM endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=linksaver-app-prod

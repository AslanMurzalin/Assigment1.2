# Environment variables for Link Saver Backend

# Secret key for JWT auth
SECRET_KEY=link-saver-super-secret-key-for-development-change-in-prod

# BHAPI Token for marketplace data extraction (Ozon, Wildberries, AliExpress)
# Register at https://bhapi.ru and copy token from https://bhapi.ru/cabinet/tokens
BHAPI_TOKEN=
BHAPI_BASE_URL=https://bhapi.ru

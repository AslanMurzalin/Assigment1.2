# ==========================================
# Link Saver Environment Configuration
# ==========================================

# Database credentials & parameters
POSTGRES_DB=linksaver
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
APP_PORT=8000

# Backend Database connection URL
# Use localhost:5432 for local development on host, or db:5432 inside Docker network
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/linksaver

# JWT secret key for token authentication
SECRET_KEY=link-saver-super-secret-key-for-development-change-in-prod

# BHAPI Token for marketplace data extraction (Ozon, Wildberries, AliExpress)
# Register at https://bhapi.ru and copy token from https://bhapi.ru/cabinet/tokens
BHAPI_TOKEN=
BHAPI_BASE_URL=https://bhapi.ru
